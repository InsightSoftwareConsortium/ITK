if(ITK_USE_FFTWD OR ITK_USE_FFTWF)
  itk_wrap_include("itkNumericTraitsVectorPixel.h")

  itk_wrap_class("itk::VariationalRegistrationElasticRegularizer" POINTER)
  foreach(d ${ITK_WRAP_IMAGE_DIMS})
    # Wrap only vector dimensions which are the same as image dimensions
    foreach(v ${WRAP_ITK_VECTOR_REAL})
      itk_wrap_template("${ITKM_I${v}${d}${d}}" "${ITKT_I${v}${d}${d}}")
    endforeach()
  endforeach()
  itk_end_wrap_class()
endif()
