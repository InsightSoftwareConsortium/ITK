itk_wrap_class("itk::ContinuousBorderWarpImageFilter" POINTER)
foreach(d ${ITK_WRAP_IMAGE_DIMS})
  # Wrap only vector dimensions which are the same as image dimensions
  foreach(s ${WRAP_ITK_SCALAR})
    foreach(v ${WRAP_ITK_VECTOR_REAL})
      itk_wrap_template(
        "${ITKM_I${s}${d}}${ITKM_I${s}${d}}${ITKM_I${v}${d}${d}}"
        "${ITKT_I${s}${d}}, ${ITKT_I${s}${d}}, ${ITKT_I${v}${d}${d}}")
    endforeach()
  endforeach()
endforeach()
itk_end_wrap_class()
