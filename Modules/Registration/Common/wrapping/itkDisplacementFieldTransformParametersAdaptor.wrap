itk_wrap_include("itkDisplacementFieldTransform.h")

itk_wrap_class("itk::TransformParametersAdaptor" POINTER)
foreach(d ${ITK_WRAP_IMAGE_DIMS})
  itk_wrap_template("DFT${ITKM_D}${d}" "itk::DisplacementFieldTransform< ${ITKT_D}, ${d} >")
  if(ITK_WRAP_vector_float)
    itk_wrap_template("DFT${ITKM_F}${d}" "itk::DisplacementFieldTransform< ${ITKT_F}, ${d} >")
  endif()
endforeach()
itk_end_wrap_class()

itk_wrap_class("itk::DisplacementFieldTransformParametersAdaptor" POINTER)
foreach(d ${ITK_WRAP_IMAGE_DIMS})
  itk_wrap_template("DFT${ITKM_D}${d}" "itk::DisplacementFieldTransform< ${ITKT_D}, ${d} >")
  if(ITK_WRAP_vector_float)
    itk_wrap_template("DFT${ITKM_F}${d}" "itk::DisplacementFieldTransform< ${ITKT_F}, ${d} >")
  endif()
endforeach()
itk_end_wrap_class()
