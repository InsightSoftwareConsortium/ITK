list(FIND ITK_WRAP_IMAGE_DIMS 3 _have_dim_3)
if(NOT ${_have_dim_3} EQUAL -1)
  itk_wrap_class("itk::CuberilleImageToMeshFilter" POINTER_WITH_2_SUPERCLASSES)
  unique(types "${WRAP_ITK_SCALAR}")
  foreach(t ${types})
    itk_wrap_template("${ITKM_I${t}3}M${ITKM_${t}}3"
                      "${ITKT_I${t}3}, itk::Mesh< ${ITKT_${t}},3 >, itk::InterpolateImageFunction< ${ITKT_I${t}3}, ${ITKT_D} >"
    )
  endforeach()
  itk_end_wrap_class()
endif()
