# The gradient filter types need Vector and CovariantVector images, which are
# always wrapped for double but for float only when enabled.
set(types D)
foreach(p ${WRAP_ITK_REAL})
  list(FIND WRAP_ITK_VECTOR_REAL "V${p}" vector_index)
  list(FIND WRAP_ITK_COV_VECTOR_REAL "CV${p}" covariant_vector_index)
  if(vector_index GREATER -1 AND covariant_vector_index GREATER -1)
    list(APPEND types ${p})
  endif()
endforeach()
list(REMOVE_DUPLICATES types)

itk_wrap_include("itkImageToImageFilter.h")
itk_wrap_class("itk::ImageToImageFilter" POINTER)
foreach(d ${ITK_WRAP_IMAGE_DIMS})
  set(vector_dim ${d}) # Wrap only vector dimensions which are the same as image dimensions
  foreach(p ${types})
    itk_wrap_template(
        "${ITKM_IV${p}${vector_dim}${d}}${ITKM_ISSRT${p}${d}${d}}"
        "${ITKT_IV${p}${vector_dim}${d}}, ${ITKT_ISSRT${p}${d}${d}}"
    )
    # VectorGradientFilterType; ITKCommon wraps it only for enabled vector types.
    list(FIND WRAP_ITK_VECTOR_REAL "V${p}" vector_index)
    list(FIND WRAP_ITK_COV_VECTOR_REAL "CV${p}" covariant_vector_index)
    if(vector_index EQUAL -1 OR covariant_vector_index EQUAL -1)
      itk_wrap_template(
          "${ITKM_IV${p}${vector_dim}${d}}${ITKM_ICV${p}${vector_dim}${d}}"
          "${ITKT_IV${p}${vector_dim}${d}}, ${ITKT_ICV${p}${vector_dim}${d}}"
      )
    endif()
  endforeach()
endforeach()
itk_end_wrap_class()

itk_wrap_class("itk::StrainImageFilter" POINTER)
foreach(d ${ITK_WRAP_IMAGE_DIMS})
  set(vector_dim ${d}) # Wrap only vector dimensions which are the same as image dimensions
  foreach(p ${types})
    itk_wrap_template(
        "${ITKM_IV${p}${vector_dim}${d}}${ITKM_${p}}${ITKM_${p}}"
        "${ITKT_IV${p}${vector_dim}${d}}, ${ITKT_${p}}, ${ITKT_${p}}"
    )
  endforeach()
endforeach()
itk_end_wrap_class()
