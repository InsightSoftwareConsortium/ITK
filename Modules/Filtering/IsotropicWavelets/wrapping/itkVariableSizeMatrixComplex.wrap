set(WRAPPER_AUTO_INCLUDE_HEADERS OFF)
itk_wrap_include("itkVariableSizeMatrix.h")

# CD is the superclass of RieszRotationMatrix.
unique(variable_size_matrix_types "${WRAP_ITK_COMPLEX_REAL};CD")

# Array is the vector type of VariableSizeMatrix, and vnl_vector its superclass.
if(NOT "CD" IN_LIST WRAP_ITK_COMPLEX_REAL)
  itk_wrap_class("vnl_vector" EXPLICIT_SPECIALIZATION)
  itk_wrap_template("${ITKM_CD}" "${ITKT_CD}")
  itk_end_wrap_class()
endif()

itk_wrap_class("itk::Array")
foreach(t ${variable_size_matrix_types})
  itk_wrap_template("${ITKM_${t}}" "${ITKT_${t}}")
endforeach()
itk_end_wrap_class()

itk_wrap_class("itk::VariableSizeMatrix")
foreach(t ${variable_size_matrix_types})
  itk_wrap_template("${ITKM_${t}}" "${ITKT_${t}}")
endforeach()
itk_end_wrap_class()
