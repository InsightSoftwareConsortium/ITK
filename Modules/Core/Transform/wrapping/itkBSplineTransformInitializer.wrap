itk_wrap_include("itkBSplineTransform.h")
itk_wrap_class("itk::BSplineTransformInitializer" POINTER)
foreach(d ${ITK_WRAP_IMAGE_DIMS})
  foreach(order RANGE 1 3)
    foreach(t ${WRAP_ITK_SCALAR})
      itk_wrap_template("BST${ITKM_D}${d}${order}${ITKM_I${t}${d}}"
                        "itk::BSplineTransform< ${ITKT_D}, ${d}, ${order} >, ${ITKT_I${t}${d}}"
      )
    endforeach()
  endforeach()
endforeach()
itk_end_wrap_class()
